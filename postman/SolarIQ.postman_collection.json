    {
      "name": "Health and Meta",
      "item": [
        {
          "name": "Check Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time is reasonable\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const json = pm.response.json();",
                  "pm.test(\"Model is loaded\", () => {",
                  "    pm.expect(json.status).to.eql(\"ok\");",
                  "    pm.expect(json.model_loaded).to.be.true;",
                  "    pm.expect(json.models).to.include(\"Plant 1\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/meta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "meta"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
